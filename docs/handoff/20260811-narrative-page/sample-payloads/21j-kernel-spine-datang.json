    },
    {
        "id": "fd0d7af9-cf2c-47af-a1ed-88fd6d7c0214",
        "title": "\u7126\u90aa\u8ffd\u67e5\u694a\u516c\u5bf6\u85cf\u7dda\u7d22",
        "chapter": 1,
        "event_type": "plot",
        "description": "\u300c\u6f2b\u5929\u738b\u300d\u738b\u9808\u62d4\u9ebe\u4e0b\u5927\u5c07\u7126\u90aa\uff0c\u6cbf\u9577\u6c5f\u75be\u99b3\uff0c\u8ffd\u67e5\u523b\u6709\u300c\u842c\u6b72\u300d\u4e8c\u5b57\u7684\u53e4\u7389\uff0c\u6b64\u7389\u662f\u968b\u671d\u958b\u570b\u5927\u5c07\u53f2\u842c\u6b72\u7684\u96a8\u8eab\u5bf6\u7389\uff0c\u4e5f\u662f\u5c0b\u627e\u300c\u694a\u516c\u5bf6\u85cf\u300d\u7684\u91cd\u8981\u7dda\u7d22\u3002",
        "significance": "\u5f15\u5165\u4e86\u53e6\u4e00\u689d\u91cd\u8981\u7684\u6545\u4e8b\u7dda\u7d22\u300c\u694a\u516c\u5bf6\u85cf\u300d\uff0c\u4e26\u63ed\u793a\u4e86\u968b\u672b\u6c11\u4e0d\u804a\u751f\u7684\u793e\u6703\u80cc\u666f\u548c\u5404\u8def\u8c6a\u96c4\u7684\u5d1b\u8d77\u3002",
        "narrative_weight": "kernel",
