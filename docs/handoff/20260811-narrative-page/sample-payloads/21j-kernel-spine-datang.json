    {
        "id": "22270b4c-6796-461e-8af0-cfaea1b6462e",
        "title": "\u5b87\u6587\u5316\u53ca\u8207\u5f35\u58eb\u548c\u8ac7\u8ad6\u300a\u9577\u751f\u8a23\u300b",
        "chapter": 1,
        "event_type": "revelation",
        "description": "\u5b87\u6587\u5316\u53ca\u8207\u5fc3\u8179\u5f35\u58eb\u548c\u8ac7\u8ad6\u300a\u9577\u751f\u8a23\u300b\uff0c\u900f\u9732\u694a\u5ee3\u5c0d\u6b64\u66f8\u7684\u75f4\u8ff7\uff0c\u4ee5\u53ca\u6b64\u66f8\u76ee\u524d\u5728\u77f3\u9f8d\u624b\u4e2d\u7684\u60c5\u5831\uff0c\u4e26\u8868\u9054\u4e86\u5c0d\u77f3\u9f8d\u7684\u8f15\u8511\u548c\u596a\u66f8\u7684\u6c7a\u5fc3\u3002",
        "significance": "\u660e\u78ba\u4e86\u5b87\u6587\u5316\u53ca\u6b64\u884c\u7684\u4e3b\u8981\u76ee\u6a19\u662f\u596a\u53d6\u300a\u9577\u751f\u8a23\u300b\uff0c\u4e26\u63ed\u793a\u4e86\u694a\u5ee3\u5c0d\u9577\u751f\u4e4b\u8853\u7684\u8ffd\u6c42\uff0c\u70ba\u5f8c\u7e8c\u60c5\u7bc0\u57cb\u4e0b\u4f0f\u7b46\u3002",
        "narrative_weight": "kernel",
