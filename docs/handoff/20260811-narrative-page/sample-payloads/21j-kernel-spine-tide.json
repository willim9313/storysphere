        "title": "\u746a\u8482\u723e\u5fb7\u592b\u4eba\u63ed\u793a\u57c3\u7c73\u5229\u5b89\u7684\u771f\u76f8",
        "chapter": 8,
        "event_type": "revelation",
        "description": "\u746a\u8482\u723e\u5fb7\u592b\u4eba\u544a\u8a34\u4f0a\u5167\u7d72\uff0c\u5979\u7684\u54e5\u54e5\u57c3\u7c73\u5229\u5b89\u662f\u88ab\u6d77\u6436\u8d70\u7684\uff0c\u5c4d\u9ad4\u6c92\u6709\u56de\u4f86\uff0c\u6d77\u5c07\u4ed6\u5c01\u5b58\u5728\u6700\u6df1\u8655\u3002\u8981\u8b80\u56de\u57c3\u7c73\u5229\u5b89\u7684\u8a18\u61b6\uff0c\u4f0a\u5167\u7d72\u5fc5\u9808\u8d70\u5230\u6ce5\u7058\u6700\u6df1\u8655\uff0c\u4f46\u9019\u610f\u5473\u8457\u5979\u53ef\u80fd\u7121\u6cd5\u5728\u6f32\u6f6e\u524d\u56de\u4f86\u3002",
        "significance": "\u63ed\u793a\u4e86\u4f0a\u5167\u7d72\u54e5\u54e5\u5931\u8e64\u7684\u771f\u6b63\u539f\u56e0\u548c\u8b80\u9e7d\u7684\u5de8\u5927\u4ee3\u50f9\uff0c\u8feb\u4f7f\u4f0a\u5167\u7d72\u9762\u81e8\u4e00\u500b\u751f\u6b7b\u6289\u64c7\u3002",
