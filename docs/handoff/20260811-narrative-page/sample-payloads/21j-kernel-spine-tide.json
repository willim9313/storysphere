    {
        "id": "ba3c594c-20be-4420-b4d0-02f9fe19a0b8",
        "title": "\u4f0a\u5167\u7d72\u7406\u89e3\u6cf0\u5967\u591a\u723e\u7684\u4f86\u610f",
        "chapter": 7,
        "event_type": "revelation",
        "description": "\u4f0a\u5167\u7d72\u8b80\u5b8c\u61f7\u9336\u7684\u8a18\u61b6\u5f8c\uff0c\u731b\u7136\u9192\u609f\uff0c\u7406\u89e3\u5230\u6cf0\u5967\u591a\u723e\u4e26\u975e\u4f86\u5077\u8a18\u61b6\uff0c\u800c\u662f\u4f86\u6b78\u9084\u9019\u6bb5\u5c6c\u65bc\u8389\u8389\u5b89\u5a1c\u3001\u88ab\u6d77\u4fdd\u7ba1\u7684\u8a18\u61b6\uff0c\u4e26\u9762\u5c0d\u81ea\u5df1\u7684\u61e6\u5f31\u3002",
        "significance": "\u4f0a\u5167\u7d72\u5c0d\u4e8b\u4ef6\u7684\u7406\u89e3\u5f9e\u56f0\u60d1\u8f49\u70ba\u6e05\u6670\uff0c\u70ba\u5f8c\u7e8c\u7684\u8a18\u61b6\u6b78\u9084\u5100\u5f0f\u92ea\u588a\u3002",
