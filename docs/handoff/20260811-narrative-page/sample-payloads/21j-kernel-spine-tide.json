    {
        "id": "65b58caa-4f81-4bff-bdde-479773474b02",
        "title": "\u8389\u8389\u5b89\u5a1c\u6295\u6d77\u81ea\u76e1",
        "chapter": 7,
        "event_type": "death",
        "description": "\u61f7\u9336\u5728\u67d0\u500b\u6e05\u6668\u505c\u8d70\uff0c\u540c\u4e00\u5929\uff0c\u85a9\u723e\u746a\u96f7\u7d0d\u50b3\u4f86\u6d88\u606f\uff0c\u8389\u8389\u5b89\u5a1c\u8d70\u9032\u9000\u6f6e\u7684\u6ce5\u7058\u6df1\u8655\uff0c\u5c07\u81ea\u5df1\u4ea4\u7d66\u4e86\u6d77\uff0c\u518d\u4e5f\u6c92\u6709\u56de\u4f86\u3002",
        "significance": "\u8389\u8389\u5b89\u5a1c\u751f\u547d\u7684\u7d42\u7d50\uff0c\u662f\u6cf0\u5967\u591a\u723e\u80cc\u53db\u7684\u76f4\u63a5\u60b2\u5287\u6027\u5f8c\u679c\uff0c\u4e5f\u89e3\u91cb\u4e86\u61f7\u9336\u70ba\u4f55\u6703\u51fa\u73fe\u5728\u6d77\u5e8a\u3002",
