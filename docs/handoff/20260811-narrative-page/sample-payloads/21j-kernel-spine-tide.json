        "description": "\u5728\u5f8c\u534a\u591c\u7cbe\u75b2\u529b\u7aed\u4e4b\u969b\uff0c\u4f0a\u5167\u7d72\u5728\u6ce5\u7058\u6df1\u8655\u767c\u73fe\u4e00\u9ede\u6bd4\u5176\u4ed6\u7269\u4ef6\u90fd\u4eae\u3001\u4e14\u50cf\u5fc3\u81df\u822c\u8df3\u52d5\u7684\u5149\u3002\u5979\u8a8d\u51fa\u90a3\u662f\u8207\u5979\u8840\u8108\u76f8\u9023\u7684\u8a18\u61b6\u5728\u547c\u559a\u5979\uff0c\u4e26\u5728\u8d70\u8fd1\u524d\u5c31\u5df2\u77e5\u9053\u90a3\u662f\u8ab0\u7684\u8a18\u61b6\u3002",
        "significance": "\u9019\u662f\u7ae0\u7bc0\u7684\u8f49\u6298\u9ede\uff0c\u9810\u793a\u8457\u4f0a\u5167\u7d72\u5c07\u63a5\u89f8\u5230\u8207\u81ea\u8eab\u5bc6\u5207\u76f8\u95dc\u7684\u3001\u53ef\u80fd\u975e\u5e38\u91cd\u8981\u7684\u8a18\u61b6\uff0c\u70ba\u5f8c\u7e8c\u60c5\u7bc0\u57cb\u4e0b\u4f0f\u7b46\u3002",
