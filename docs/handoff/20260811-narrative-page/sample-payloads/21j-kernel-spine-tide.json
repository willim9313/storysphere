    {
        "id": "533d2db8-4a2d-403b-89aa-d58111f52dac",
        "title": "\u4f0a\u5167\u7d72\u8207\u6cf0\u5967\u591a\u723e\u30fb\u842c\u514b\u5728\u9e79\u6c34\u4e95\u908a\u76f8\u9047",
        "chapter": 3,
        "event_type": "meeting",
        "description": "\u4f0a\u5167\u7d72\u5728\u9e79\u6c34\u4e95\u908a\u6253\u6c34\u6642\uff0c\u9047\u5230\u4e86\u6cf0\u5967\u591a\u723e\u30fb\u842c\u514b\u3002\u6cf0\u5967\u591a\u723e\u30fb\u842c\u514b\u5411\u4f0a\u5167\u7d72\u5c55\u793a\u4e86\u4e00\u53ea\u61f7\u9336\uff0c\u4e26\u8a62\u554f\u5979\u662f\u5426\u662f\u8b80\u9e7d\u4eba\uff0c\u8acb\u6c42\u5979\u5e6b\u5fd9\u5c0b\u627e\u8389\u8389\u5b89\u5a1c\u7684\u8a18\u61b6\u3002",
        "significance": "\u78ba\u7acb\u4e86\u5169\u4f4d\u4e3b\u8981\u89d2\u8272\u4e4b\u9593\u7684\u4e92\u52d5\uff0c\u63ed\u793a\u4e86\u6cf0\u5967\u591a\u723e\u30fb\u842c\u514b\u7684\u76ee\u7684\uff0c\u4e26\u6697\u793a\u4e86\u4f0a\u5167\u7d72\u5728\u5373\u5c07\u5230\u4f86\u7684\u300c\u9000\u540d\u4e4b\u6f6e\u300d\u4e2d\u7684\u89d2\u8272\u3002",
