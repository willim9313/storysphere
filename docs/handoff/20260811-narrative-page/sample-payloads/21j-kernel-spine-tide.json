        "chapter": 7,
        "event_type": "plot",
        "description": "\u4f0a\u5167\u7d72\u7528\u8389\u8389\u5b89\u5a1c\u7684\u8072\u97f3\u8b80\u51fa\u61f7\u9336\u4e2d\u7684\u8a18\u61b6\uff0c\u7576\u8b80\u5230\u300c\u54ea\u5929\u5b83\u505c\u4e86\uff0c\u5c31\u662f\u6211\u4e0d\u7b49\u4e86\u300d\u6642\uff0c\u6cf0\u5967\u591a\u723e\u4f0f\u5730\u75db\u54ed\uff0c\u61f7\u9336\u5728\u4f0a\u5167\u7d72\u638c\u5fc3\u788e\u6210\u767d\u9e7d\u3002",
        "significance": "\u9019\u662f\u8a18\u61b6\u6b78\u9084\u5100\u5f0f\u7684\u6838\u5fc3\uff0c\u8b93\u6cf0\u5967\u591a\u723e\u76f4\u9762\u904e\u53bb\u7684\u932f\u8aa4\uff0c\u4e26\u6700\u7d42\u91cb\u653e\u4e86\u58d3\u6291\u5e7e\u5341\u5e74\u7684\u60c5\u611f\u3002",
