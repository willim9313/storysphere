            "chapter_number": 5,
            "position": 0,
            "paragraph_text": "\u6d77 \u9000 \u958b \u4e86\n\u2767 \u9000\u540d\u4e4b\u6f6e\uff0c\u662f\u5728\u4e00\u500b\u6c92\u6709\u6708\u4eae\u7684\u591c\u88e1\u958b\u59cb\u7684\u3002  \u90a3\u5929\u508d\u665a\uff0c\u93ae\u4e0a\u6240\u6709\u4eba\u90fd\u805a\u5230\u4e86\u5cb8\u908a\u7684\u7901\u77f3\u4e0a\u3002 \u8001\u4eba\u3001\u5b69\u5b50\u3001 \u62b1\u8457\u5b30\u5152\u7684\u5a66\u4eba\u3001\u62c4\u8457\u62d0\u7684\u6f01\u592b\uff0c\u5168\u90fd\u4f86\u4e86\u3002 \u4ed6\u5011\u5e36\u8457\u6cb9\u71c8\u3001\u5e36\u8457 \u6bef\u5b50\u3001\u5e36\u8457\u8981\u8a8d\u9818\u7684\u89aa\u4eba\u7684\u540d\u5b57\u3002 \u7a7a\u6c23\u88e1\u6709\u4e00\u7a2e\u7bc0\u6176\u822c\u7684\u7dca\u5f35\uff0c\u53c8 \u6709\u4e00\u7a2e\u846c\u79ae\u822c\u7684\u8085\u7a46\u2014\u2014\u5728\u85a9\u723e\u746a\u96f7\u7d0d\uff0c\u9019\u5169\u4ef6\u4e8b\u672c\u4f86\u5c31\u662f\u540c\u4e00\u4ef6 \u4e8b\u3002  \u5df4\u723e\u5854\u85a9\u795e\u7236\u4e5f\u4f86\u4e86\u3002 \u4ed6\u7ad9\u5728\u4eba\u7fa4\u6700\u5916\u570d\uff0c\u624b\u88e1\u634f\u8457\u5ff5\u73e0\uff0c\u81c9 \u7e43\u5f97\u5f88\u7dca\u3002 \u6559\u6703\u5f9e\u4e0d\u627f\u8a8d\u8b80\u9e7d\u9019\u56de\u4e8b\uff0c\u8aaa\u90a3\u662f\u7570\u7aef\uff0c\u662f\u8ddf\u4e0d\u6f54\u7684\u6771 \u897f\u6253\u4ea4\u9053\u3002 \u53ef\u6bcf\u4e03\u5e74\uff0c\u795e\u7236\u9084\u662f\u6703\u4f86\u3002 \u4ed6\u5634\u4e0a\u70ba\u6b7b\u8005\u7684\u9748\u9b42\u79b1\u544a\uff0c \u773c\u775b\u537b\u6b7b\u6b7b\u76ef\u8457\u90a3\u7247\u6b63\u5728\u9000\u958b\u7684\u6d77\u2014\u2014\u56e0\u70ba\u9023\u4ed6\u81ea\u5df1\uff0c\u4e5f\u5728\u5077\u5077\u7b49 \u4e00\u500b\u540d\u5b57\uff1a\u4ed6\u65e9\u901d\u7684\u59b9\u59b9\u3002 \u4fe1\u4ef0\u64cb\u4e0d\u4f4f\u601d\u5ff5\uff0c\u9019\u4e00\u9ede\uff0c\u6d77\u6bd4\u6559\u6703\u61c2 \u5f97\u591a\u3002",
            "context_window": "\u773c\u775b\u537b\u6b7b\u6b7b\u76ef\u8457\u90a3\u7247\u6b63\u5728\u9000\u958b\u7684\u6d77\u2014\u2014\u56e0\u70ba\u9023\u4ed6\u81ea\u5df1\uff0c\u4e5f\u5728\u5077\u5077\u7b49 \u4e00\u500b\u540d\u5b57\uff1a\u4ed6\u65e9\u901d\u7684\u59b9\u59b9\u3002"
        },
        {
            "occurrence_id": "5dcbbef0-34d4-4a01-95ec-7ffd6335c124",
            "paragraph_id": "ace2a5d6-4e63-4978-a8e2-05535e7c67a9",
            "chapter_number": 7,
            "position": 0,
            "paragraph_text": "\u4e0d \u5c6c \u65bc \u4ed6 \u7684 \u8a18 \u61b6\n\u2767 \u53ef\u662f\u5728\u5979\u8d70\u5411\u90a3\u9ede\u9060\u5149\u4e4b\u524d\uff0c\u6709\u53e6\u4e00\u4ef6\u6771\u897f\u6514\u4f4f\u4e86\u5979\u3002  \u5c31\u5728\u6ce5\u7058\u4e2d\u6bb5\uff0c\u96e2\u5cb8\u4e0d\u9060\u4e0d\u8fd1\u7684\u5730\u65b9\uff0c\u8eba\u8457\u4e00\u53ea\u61f7\u9336\u3002  \u4f0a\u5167\u7d72\u4e00\u773c\u5c31\u8a8d\u51fa\u4e86\u5b83\u2014\u2014\u820a\u9280\u7684\u9336\u84cb\uff0c\u78e8\u5f97\u767c\u4eae\uff0c\u4e0a\u982d\u523b\u8457 \u4e00\u500b\u5916\u5730\u7684\u59d3\u6c0f\u7e2e\u5beb\u3002 \u90a3\u662f\u9418\u9336\u5320\u6cf0\u5967\u591a\u723e\u7684\u61f7\u9336\u3002 \u53ef\u5b83\u660e\u660e\u61c9\u8a72 \u5728\u4ed6\u5916\u5957\u7684\u5167\u888b\u88e1\u3002 \u5b83\u600e\u9ebc\u6703\u8eba\u5728\u9019\u7247\u4e03\u5e74\u624d\u88f8\u9732\u4e00\u6b21\u7684\u6d77\u5e8a\u4e0a\uff0c \u6cdb\u8457\u8a18\u61b6\u7684\u5149\uff1f  \u5979\u8e72\u4e0b\u53bb\u3002 \u76ae\u819a\u50b3\u4f86\u7684\u7662\uff0c\u548c\u5225\u7684\u7269\u4ef6\u4e0d\u4e00\u6a23\u2014\u2014\u9019\u4e00\u6bb5\u8a18\u61b6 \u88e1\u6709\u4e00\u7a2e\u707c\u71d2\u4f3c\u7684\u6094\u6068\uff0c\u71d9\u5f97\u5979\u6307\u5c16\u767c\u75bc\u3002 \u5979\u7336\u8c6b\u4e86\u3002 \u9019\u4e0d\u662f\u85a9\u723e \u746a\u96f7\u7d0d\u6b7b\u8005\u7684\u8a18\u61b6\uff0c\u9019\u662f\u5916\u5730\u4eba\u7684\u3001\u6d3b\u4eba\u7684\u6771\u897f\u3002 \u5b83\u4e0d\u8a72\u51fa\u73fe\u5728\u9019 \u88e1\u3002  \u53ef\u8b80\u9e7d\u4eba\u7684\u5929\u6027\uff0c\u662f\u4e0d\u80fd\u5c0d\u4e00\u6bb5\u5728\u558a\u5979\u7684\u8a18\u61b6\u8f49\u8eab\u4e0d\u7406\u7684\u3002 \u5979 \u54ac\u7834\u6307\u5c16\uff0c\u62b9\u4e86\u4e0a\u53bb\u3002  \u8a18\u61b6\u6e67\u9032\u4f86\u2014\u2014",
            "context_window": "\u5b83\u600e\u9ebc\u6703\u8eba\u5728\u9019\u7247\u4e03\u5e74\u624d\u88f8\u9732\u4e00\u6b21\u7684\u6d77\u5e8a\u4e0a\uff0c \u6cdb\u8457\u8a18\u61b6\u7684\u5149\uff1f"
        },
        {
            "occurrence_id": "93605095-8324-4bf8-a6cb-950bd594e5b5",
            "paragraph_id": "fd1b3ce0-89d5-44e0-bdf7-fc10d8d2816d",
            "chapter_number": 7,
            "position": 2,
            "paragraph_text": "31 \u5f88\u591a\u5e74\u524d\uff0c\u4e00\u5ea7\u5167\u9678\u7684\u5c0f\u57ce\u3002 \u5e74\u8f15\u7684\u6cf0\u5967\u591a\u723e\u662f\u500b\u6709\u5929\u5206\u7684\u9418 \u9336\u5b78\u5f92\uff0c\u7aae\uff0c\u537b\u9a55\u50b2\u3002 \u4ed6\u611b\u4e0a\u4e86\u4e00\u500b\u53eb\u8389\u8389\u5b89\u5a1c\u7684\u59d1\u5a18\uff0c\u6d77\u908a\u4eba\u5bb6 \u7684\u5973\u5152\uff0c\u4f86\u57ce\u88e1\u6295\u9760\u89aa\u621a\u3002 \u5979\u6709\u4e00\u96d9\u7e3d\u50cf\u542b\u8457\u6d77\u6c34\u7684\u773c\u775b\u3002 \u4ed6\u5011\u7d04 \u5b9a\uff0c\u7b49\u4ed6\u6522\u5920\u4e86\u9322\uff0c\u958b\u4e00\u9593\u81ea\u5df1\u7684\u9336\u884c\uff0c\u5c31\u7d50\u5a5a\u3002  \u53ef\u662f\u6a5f\u6703\u4f86\u4e86\u2014\u2014\u57ce\u88e1\u6700\u5927\u7684\u9418\u9336\u884c\u8001\u95c6\u8cde\u8b58\u4ed6\uff0c\u9858\u610f\u6536\u4ed6\u505a \u5973\u5a7f\uff0c\u689d\u4ef6\u662f\u5a36\u8001\u95c6\u7684\u5973\u5152\u3002 \u90a3\u610f\u5473\u8457\u8ca1\u5bcc\u3001\u540d\u8072\u3001\u4e00\u8f29\u5b50\u4e0d\u5fc5\u518d \u7aae\u3002 \u6cf0\u5967\u591a\u723e\u52d5\u6416\u4e86\u3002 \u4ed6\u4e00\u6b21\u53c8\u4e00\u6b21\u63a8\u9072\u548c\u8389\u8389\u5b89\u5a1c\u7684\u5a5a\u7d04\uff0c\u627e\u5404 \u7a2e\u85c9\u53e3\u3002 \u8389\u8389\u5b89\u5a1c\u4ec0\u9ebc\u90fd\u61c2\uff0c\u537b\u4ec0\u9ebc\u90fd\u6c92\u8aaa\u3002  \u76f4\u5230\u6709\u4e00\u5929\uff0c\u5979\u628a\u4e00\u6a23\u6771\u897f\u653e\u5728\u4ed6\u5de5\u4f5c\u6aaf\u4e0a\u2014\u2014\u4e00\u53ea\u5979\u89aa\u624b\u66ff \u4ed6\u6522\u9322\u8cb7\u4e0b\u7684\u3001\u6700\u666e\u901a\u7684\u61f7\u9336\uff0c\u9336\u84cb\u5167\u5074\u523b\u8457\u4ed6\u5011\u5169\u4eba\u59d3\u6c0f\u7684\u7e2e \u5beb\u3002 \u5979\u8aaa\uff1a\u300c\u6211\u4e0d\u7559\u4f60\u4e86\u3002 \u53ef\u662f\u9019\u53ea\u9336\uff0c\u4f60\u66ff\u6211\u6536\u8457\u3002 \u5b83\u8d70\u4e00\u5929\uff0c \u5c31\u662f\u6211\u9084\u5728\u7b49\u4f60\u56de\u982d\u7684\u4e00\u5929\u3002 \u54ea\u5929\u5b83\u505c\u4e86\uff0c\u5c31\u662f\u6211\u4e0d\u7b49\u4e86\u3002 \u300d \u7136\u5f8c\u5979\u56de\u4e86\u6d77\u908a\uff0c\u56de\u4e86\u90a3\u500b\u53eb\u85a9\u723e\u746a\u96f7\u7d0d\u7684\u5c0f\u93ae\u3002 \u800c\u6cf0\u5967\u591a \u723e\uff0c\u5a36\u4e86\u8001\u95c6\u7684\u5973\u5152\u3002 \u4ed6\u628a\u90a3\u53ea\u61f7\u9336\u9396\u9032\u62bd\u5c5c\uff0c\u4e0d\u6562\u4e0a\u767c\u689d\u2014\u2014\u4ed6 \u4ee5\u70ba\u53ea\u8981\u4e0d\u8b93\u5b83\u8d70\uff0c\u5c31\u4e0d\u5fc5\u9762\u5c0d\u90a3\u4e00\u5929\u3002  \u53ef\u61f7\u9336\u9084\u662f\u5728\u67d0\u500b\u6e05\u6668\uff0c\u81ea\u5df1\u505c\u4e86\u3002  \u5c31\u5728\u90a3\u4e00\u5929\uff0c\u6d77\u7684\u53e6\u4e00\u7aef\uff0c\u85a9\u723e\u746a\u96f7\u7d0d\u50b3\u4f86\u6d88\u606f\uff1a\u4e00\u500b\u53eb\u8389\u8389 \u5b89\u5a1c\u7684\u5973\u4eba\uff0c\u6d89\u6d77\u8d70\u9032\u4e86\u9000\u6f6e\u7684\u6ce5\u7058\u6df1\u8655\uff0c\u518d\u4e5f\u6c92\u6709\u56de\u4f86\u3002 \u5979\u628a\u81ea \u5df1\uff0c\u4ea4\u7d66\u4e86\u6d77\u3002",
            "context_window": "\u5979\u6709\u4e00\u96d9\u7e3d\u50cf\u542b\u8457\u6d77\u6c34\u7684\u773c\u775b\u3002"
        },
        {
            "occurrence_id": "d76e6cb6-0a03-48f6-b3ab-2e32e06d934a",
            "paragraph_id": "c15650c2-abb8-4e66-b211-5026a908978d",
            "chapter_number": 8,
            "position": 0,
            "paragraph_text": "\u746a \u8482 \u723e \u5fb7 \u7684 \u6700 \u5f8c \u4e00 \u8ab2\n\u2767 \u5929\u5feb\u4eae\u7684\u6642\u5019\uff0c\u746a\u8482\u723e\u5fb7\u592b\u4eba\u8d70\u4e86\u3002  \u5979\u662f\u5750\u5728\u7901\u77f3\u4e0a\u8d70\u7684\uff0c\u81c9\u671d\u8457\u90a3\u7247\u9000\u5230\u5929\u908a\u7684\u6d77\u3002 \u6c92\u6709\u4eba\u767c\u73fe \u5979\u662f\u4ec0\u9ebc\u6642\u5019\u505c\u6b62\u547c\u5438\u7684\u2014\u2014\u5979\u8d70\u5f97\u90a3\u9ebc\u5b89\u975c\uff0c\u5c31\u50cf\u5979\u9019\u4e00\u751f\u8b80\u904e \u7684\u3001\u6240\u6709\u90a3\u4e9b\u6eab\u67d4\u7684\u6b7b\u8005\u4e00\u6a23\uff0c\u53ea\u662f\u60f3\u56de\u5bb6\u3002  \u4f0a\u5167\u7d72\u662f\u6700\u5f8c\u4e00\u500b\u548c\u5979\u8aaa\u8a71\u7684\u4eba\u3002 \u90a3\u662f\u5728\u5979\u8b80\u5b8c\u61f7\u9336\u3001\u7cbe\u75b2\u529b \u7aed\u5730\u56de\u5230\u7901\u77f3\u4e0a\u6642\u3002 \u8001\u592a\u592a\u4f38\u51fa\u4e7e\u67af\u7684\u624b\uff0c\u6478\u5230\u5979\u7684\u81c9\uff0c\u66ff\u5979\u64e6\u6389 \u81c9\u4e0a\u7684\u6ce5\u548c\u6dda\u3002  \u300c\u59b3\u8b80\u5f97\u5f88\u597d\uff0c\u300d\u8001\u592a\u592a\u8f15\u8072\u8aaa\uff0c\u300c\u6bd4\u6211\u7b2c\u4e00\u6b21\u597d\u3002 \u300d \u300c\u592b\u4eba\uff0c\u6211\u9084\u6709\u4e00\u4ef6\u6c92\u8b80\u3002 \u300d\u4f0a\u5167\u7d72\u671b\u5411\u6ce5\u7058\u6df1\u8655\u90a3\u9ede\u4ecd\u5728\u8df3 \u52d5\u7684\u5149\uff0c\u8072\u97f3\u767c\u986b\uff0c\u300c\u90a3\u88e1\u2026\u2026\u90a3\u662f\u6211\u54e5\u54e5\u3002 \u6211\u77e5\u9053\u662f\u4ed6\u3002 \u6211\u76ae\u819a \u4e00\u76f4\u5728\u7662\u3002 \u300d \u746a\u8482\u723e\u5fb7\u592b\u4eba\u7684\u624b\u505c\u5728\u5979\u81c9\u4e0a\uff0c\u5f88\u4e45\u5f88\u4e45\u3002 \u6d77\u98a8\u63a0\u904e\u5169\u4eba\uff0c\u5e36 \u8457\u9ece\u660e\u524d\u6700\u51b7\u7684\u90a3\u4e00\u7e37\u3002  \u300c\u6211\u77e5\u9053\u59b3\u6703\u554f\u9019\u500b\u3002 \u300d\u8001\u592a\u592a\u7d42\u65bc\u8aaa\uff0c\u300c\u6240\u4ee5\u6211\u7559\u4e86\u6700\u5f8c\u4e00 \u8ab2\uff0c\u4e00\u76f4\u6c92\u6559\u59b3\u3002 \u73fe\u5728\uff0c\u807d\u597d\u4e86\u3002 \u300d 34",
            "context_window": "\u5979\u662f\u5750\u5728\u7901\u77f3\u4e0a\u8d70\u7684\uff0c\u81c9\u671d\u8457\u90a3\u7247\u9000\u5230\u5929\u908a\u7684\u6d77\u3002"
        },
        {
            "occurrence_id": "0fb37b97-1d05-4a6f-8436-5d513d7bf19f",
            "paragraph_id": "3224aede-9546-4dcf-af9b-d543b4efc65a",
            "chapter_number": 9,
            "position": 0,
            "paragraph_text": "\u540d \u5b57 \u7684 \u8d16 \u91d1\n\u2767 \u746a\u8482\u723e\u5fb7\u592b\u4eba\u7684\u8eab\u9ad4\u9084\u6709\u9918\u6eab\uff0c\u4f0a\u5167\u7d72\u537b\u5df2\u7d93\u7ad9\u8d77\u4f86\uff0c\u8d70\u4e0b\u4e86\u7901 \u77f3\u3002  \u5979\u77e5\u9053\u81ea\u5df1\u4e0d\u8a72\u3002 \u5979\u525b\u525b\u89aa\u8033\u807d\u5b8c\u90a3\u6700\u5f8c\u4e00\u8ab2\u3002 \u53ef\u6709\u4e9b\u9053\u7406\uff0c \u4eba\u662f\u61c2\u4e86\u4e4b\u5f8c\u624d\u66f4\u96e3\u7167\u8457\u505a\u7684\u3002 \u6ce5\u7058\u6df1\u8655\u90a3\u9ede\u5149\u9084\u5728\u8df3\uff0c\u4e00\u4e0b\uff0c\u4e00 \u4e0b\uff0c\u50cf\u57c3\u7c73\u5229\u5b89\u5c0f\u6642\u5019\u534a\u591c\u6015\u9ed1\uff0c\u4f86\u6572\u5979\u623f\u9580\u7684\u90a3\u7a2e\u7bc0\u594f\u2014\u2014\u4e09\u4e0b \u8f15\u7684\uff0c\u4e00\u4e0b\u91cd\u7684\u3002 \u90a3\u662f\u4ed6\u5011\u5144\u59b9\u4e4b\u9593\u7684\u6697\u865f\u3002 \u6d77\u628a\u9019\u500b\u90fd\u8a18\u5f97\u3002 \u6d77 \u6bd4\u8ab0\u90fd\u72e0\uff0c\u56e0\u70ba\u5b83\u77e5\u9053\u8981\u7528\u4ec0\u9ebc\u4f86\u52fe\u4f4f\u4f60\u3002  \u4f0a\u5167\u7d72\u4e00\u6b65\u4e00\u6b65\u5f80\u6df1\u8655\u8d70\u3002 \u6ce5\u5f9e\u8173\u8e1d\u6f2b\u5230\u5c0f\u817f\uff0c\u5f9e\u5c0f\u817f\u6f2b\u5230\u819d \u84cb\u3002 \u8d8a\u5f80\u6df1\u8d70\uff0c\u6ce5\u8d8a\u8edf\uff0c\u8d8a\u6dbc\uff0c\u6bcf\u4e00\u6b65\u90fd\u50cf\u88ab\u6d77\u8f15\u8f15\u62fd\u4f4f\u3002 \u8eab\u5f8c\u7684 \u71c8\u706b\u8d8a\u4f86\u8d8a\u9060\uff0c\u8d8a\u4f86\u8d8a\u5c0f\uff0c\u93ae\u5b50\u7684\u547c\u558a\u88ab\u98a8\u626f\u5f97\u807d\u4e0d\u6e05\u4e86\u3002 \u5979\u53ea\u807d \u898b\u81ea\u5df1\u7684\u5fc3\u8df3\uff0c\u548c\u524d\u65b9\u90a3\u9ede\u5149\u8d8a\u4f86\u8d8a\u97ff\u7684\u3001\u8207\u5979\u8840\u8108\u76f8\u9023\u7684\u640f\u52d5\u3002",
            "context_window": "\u6d77\u628a\u9019\u500b\u90fd\u8a18\u5f97\u3002"
        },
