      "css": ".ds-rail{display:flex;flex-direction:column;align-items:center;gap:var(--space-2);width:48px;padding:var(--space-5) 0;background:var(--bg-secondary);border-right:var(--line-weight) var(--border-style) var(--border);} .ds-rail-item{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius-md);color:var(--fg-secondary);cursor:pointer;transition:background-color var(--transition-fast),color var(--transition-fast);} .ds-rail-item:hover{background:var(--bg-tertiary);} .ds-rail-item.is-active{background:var(--bg-tertiary);color:var(--accent);} .ds-rail-item:focus-visible{outline:var(--focus-ring-width) solid var(--focus-ring-color);outline-offset:var(--focus-ring-offset);}"
