      "html": "<span class=\"ds-pill ds-pill-char\"><span class=\"ds-dot\"></span>葉文潔</span> <span class=\"ds-pill ds-pill-loc\"><span class=\"ds-dot\"></span>紅岸基地</span> <span class=\"ds-pill ds-pill-con\"><span class=\"ds-dot\"></span>黑暗森林</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:var(--space-2);font-family: var(--font-sans);font-size:var(--font-size-2xs);padding:var(--space-1) var(--space-4);border-radius:var(--pill-radius);border:var(--pill-border-width) solid;} .ds-dot{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.8;} .ds-pill-char{background:var(--entity-char-bg);border-color:var(--entity-char-border);color:var(--entity-char-fg);} .ds-pill-loc{background:var(--entity-loc-bg);border-color:var(--entity-loc-border);color:var(--entity-loc-fg);} .ds-pill-con{background:var(--entity-con-bg);border-color:var(--entity-con-border);color:var(--entity-con-fg);}"
