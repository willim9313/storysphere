      "html": "<a class=\"ds-card\"><div class=\"ds-card-cover\"></div><div class=\"ds-card-title\">書名</div><div class=\"ds-card-meta\">作者 · 32 章</div></a>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:var(--space-3);width:200px;padding:var(--space-6);background:var(--bg-primary);border:var(--card-border-width) var(--border-style) var(--border);border-radius:var(--card-radius);box-shadow:var(--card-shadow);cursor:pointer;color:inherit;text-decoration:none;transition:background-color var(--transition-fast);} .ds-card:hover{background:var(--bg-secondary);} .ds-card-cover{height:90px;border-radius:var(--radius-md);background:var(--bg-tertiary);} .ds-card-title{font-family:var(--font-serif);font-size:var(--font-size-base);font-weight:700;color:var(--fg-primary);} .ds-card-meta{font-family: var(--font-sans);font-size:var(--font-size-2xs);color:var(--fg-muted);}"
    },
