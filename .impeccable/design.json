  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "焦赭填色主動作；會消耗 token 時帶 sparkles 字符。",
      "html": "<button class=\"ds-btn ds-btn-primary\">開始分析</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:var(--space-3);font-family: var(--font-sans);font-weight:500;font-size:var(--font-size-xs);padding:var(--space-4) var(--space-6);border-radius:var(--btn-radius);border:var(--btn-border-width) solid transparent;cursor:pointer;transition:opacity var(--transition-fast),background-color var(--transition-fast),color var(--transition-fast);} .ds-btn-primary{background:var(--accent);color:var(--accent-fg);} .ds-btn-primary:hover{opacity:.9;} .ds-btn-primary:active{opacity:.95;} .ds-btn:focus-visible{outline:var(--focus-ring-width) solid var(--focus-ring-color);outline-offset:var(--focus-ring-offset);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "紙底墨字毛邊框；hover／active 逐階降紙。",
      "html": "<button class=\"ds-btn-secondary\">取消</button>",
      "css": ".ds-btn-secondary{font-family: var(--font-sans);font-weight:500;font-size:var(--font-size-xs);padding:var(--space-4) var(--space-6);border-radius:var(--btn-radius);background:var(--bg-primary);color:var(--fg-primary);border:var(--btn-border-width) var(--border-style) var(--border);cursor:pointer;transition:background-color var(--transition-fast);} .ds-btn-secondary:hover{background:var(--bg-secondary);} .ds-btn-secondary:active{background:var(--bg-tertiary);} .ds-btn-secondary:focus-visible{outline:var(--focus-ring-width) solid var(--focus-ring-color);outline-offset:var(--focus-ring-offset);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "透明底褪墨字，hover 轉焦赭。",
