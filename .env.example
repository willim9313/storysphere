# ============================================================
# StorySphere v4 prototype - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ========== LLM Providers ==========
# 金鑰只放在環境變數；var/settings.yaml 只記環境變數名（docs/spec/01 §1）。
# 原型最少只需要 Gemini 一個 provider。
GEMINI_API_KEY=your_gemini_api_key_here

# ========== Tests ==========
# 入庫整合測試用的 benchmark 文本目錄（文本不放進 repo）。
BENCHMARK_DIR=
